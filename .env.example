# ─── EcoDrone AI Backend — variables de entorno ───────────────────────────────
# Copia este archivo como ".env" y rellena los valores reales
# NUNCA subas el archivo .env al repositorio

# Cadena de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host/nombre_bd?sslmode=require
DATABASE_URL=postgresql://usuario:contraseña@host/nombre_bd?sslmode=require

# Clave secreta para firmar los JWT (mínimo 32 caracteres aleatorios)
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_segura

# Tiempo de vida del token de acceso en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Directorio local para archivos subidos (desarrollo)
UPLOAD_DIR=uploads

# Cloudinary (producción en Render) — descomentar cuando esté listo
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name